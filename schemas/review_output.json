{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewOutput",
  "type": "object",
  "required": ["topic", "slug", "approved", "overall_score", "publish_ready", "linkedin_post", "infographic_prompt"],
  "properties": {
    "topic": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "approved": { "type": "boolean" },
    "overall_score": { "type": "integer", "minimum": 1, "maximum": 10 },
    "issues_found": {
      "type": "array",
      "items": { "type": "string" }
    },
    "issues_fixed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "linkedin_post": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 3000,
          "description": "Full LinkedIn post ready to copy-paste, including line breaks, emojis, and hashtags"
        },
        "call_to_action": { "type": "string" }
      }
    },
    "infographic_prompt": {
      "type": "string",
      "description": "Detailed, ready-to-use text prompt for an AI image generator to create a professional supply chain / AI infographic"
    },
    "publish_ready": { "type": "boolean" }
  }
}
