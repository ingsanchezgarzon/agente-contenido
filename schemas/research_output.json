{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchOutput",
  "type": "object",
  "required": ["topic", "slug", "date_researched", "sources", "key_facts"],
  "properties": {
    "topic": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "date_researched": { "type": "string", "format": "date-time" },
    "search_queries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "title", "snippet"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "snippet": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "key_facts": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "relevant_laws": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "statistics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expert_quotes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
